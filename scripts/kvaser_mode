#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
driver_mode_script="$script_dir/kvaser-driver-mode.sh"

if [[ ! -x "$driver_mode_script" ]]; then
  driver_mode_script="/usr/lib/kvaser_utils/kvaser-driver-mode.sh"
fi

usage() {
  cat <<'USAGE'
Usage:
  kvaser_mode -l|--linuxcan
  kvaser_mode -s|--socketcan
  kvaser_mode -t|--status

Shortcuts:
  -l, --linuxcan   switch KVASER -> LinuxCAN (mhydra)
  -s, --socketcan  switch KVASER -> SocketCAN (kvaser_usb)
  -t, --status     show current runtime mode
USAGE
}

if [[ "$#" -ne 1 ]]; then
  usage
  exit 1
fi

case "$1" in
  -l|--linuxcan)
    exec "$driver_mode_script" linuxcan
    ;;
  -s|--socketcan)
    exec "$driver_mode_script" socketcan
    ;;
  -t|--status)
    exec "$driver_mode_script" status
    ;;
  *)
    usage
    exit 1
    ;;
esac
